# ============================================================
# Modèle de configuration des secrets — copier vers .env
#   cp .env.example .env
# Le fichier .env est ignoré par git et ne doit JAMAIS être committé.
# ============================================================

# --- Clés API exchange (mode testnet/live uniquement ; inutiles en mode paper) ---
# RÈGLES DE SÉCURITÉ (cf. docs/GO_LIVE_CHECKLIST.md) :
#   * Créer les clés avec permissions TRADE-ONLY — jamais "withdrawal".
#   * Activer la whitelist IP sur l'exchange.
#   * Utiliser un compte dédié au bot avec un capital minimal.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Clés testnet (séparées des clés réelles)
EXCHANGE_TESTNET_API_KEY=
EXCHANGE_TESTNET_API_SECRET=

# --- Alertes optionnelles (Phase 8) ---
# Webhook Discord ou token/chat_id Telegram ; laisser vide pour désactiver.
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
